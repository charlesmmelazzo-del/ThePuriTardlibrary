# PostgreSQL connection string (Railway sets this automatically when you add a Postgres database)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/puritan

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# The admin account. It is created (or its password reset) every time the server starts.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Shown to users who have trouble logging in
SUPPORT_EMAIL=mike@cgcocktails.com

# Name shown in the header and browser tab
APP_NAME=The PuriTard Library

# Subtitle shown under the name
APP_TAGLINE=Rich Historical Texts for Modern Tards

# Port (Railway sets this automatically)
PORT=3000
